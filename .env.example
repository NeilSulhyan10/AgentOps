# Copy to .env and fill in what you need. Every value is optional: with no .env at all,
# AgentOps runs in rules mode (no LLM, no database) using the scenarios in ./data.

# Who makes decisions: "rules" (offline, deterministic) or "nemotron" (real LLM)
LLM_PROVIDER=rules
NEMOTRON_API_KEY=
NEMOTRON_API_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Investigation behaviour
MAX_ITERATIONS=5
CONFIDENCE_THRESHOLD=0.75
ENABLE_CRITIC=true
CRITIC_MAX_ROUNDS=3

# Server mode only
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agentops

# GitHub Actions monitor only
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=
GITHUB_TIME_WINDOW_HOURS=24
GITHUB_POLL_INTERVAL_SECONDS=60

# Debugging aids
# LLM_TRACE_ENABLED=true     # save every prompt/response to logs/llm_traces.jsonl (contains incident data)
# FAULT_INJECTION=agent_crash  # see: python scripts/investigate.py faults

# Optional: send every LLM call to Langfuse. Leave the keys empty to disable.
# Host: https://cloud.langfuse.com (EU cloud) | https://us.cloud.langfuse.com (US cloud) | your own Langfuse v3 server
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
